{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn", "oxc"],
  "jsPlugins": [
    {
      "name": "stylex",
      "specifier": "@stylexjs/eslint-plugin"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "stylex/valid-styles": "error",
    "stylex/valid-shorthands": "error",
    "stylex/no-unused": "error",
    "stylex/no-conflicting-props": "error",
    "stylex/enforce-extension": "error",
    "stylex/no-legacy-contextual-styles": "error",
    "stylex/no-lookahead-selectors": "error",
    "stylex/no-nonstandard-styles": "error",
    "stylex/sort-keys": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "lucide-react",
            "message": "Import icons from the Shelf icons item (components/icons/icons.tsx) so users can swap the icon library in one file."
          },
          {
            "name": "recharts",
            "message": "Import chart parts from the Shelf chart items (components/chart*), so a Recharts change is fixed in one file you own."
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/storybook-static/**",
    "**/.tmp/**",
    "apps/**",
    "examples/**"
  ],
  "overrides": [
    {
      "files": ["registry/components/icons/icons.tsx"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["registry/components/chart*/*.tsx", "registry/components/sparkline/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "lucide-react",
                "message": "Import icons from the Shelf icons item (components/icons/icons.tsx) so users can swap the icon library in one file."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["registry/**/*.stories.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "lucide-react",
                "message": "Import icons from the Shelf icons item (components/icons/icons.tsx) so users can swap the icon library in one file."
              },
              {
                "name": "recharts",
                "message": "Import chart parts from the Shelf chart items (components/chart*), so a Recharts change is fixed in one file you own."
              }
            ]
          }
        ]
      }
    }
  ]
}
