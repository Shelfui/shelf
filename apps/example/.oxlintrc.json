{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn", "oxc"],
  "jsPlugins": [{ "name": "stylex", "specifier": "@stylexjs/eslint-plugin" }],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "typescript/no-floating-promises": "error",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
    "stylex/valid-styles": "error",
    "stylex/valid-shorthands": "error",
    "stylex/no-unused": "error",
    "stylex/enforce-extension": "error"
  },
  "ignorePatterns": ["dist/**", ".shelf/**"]
}
