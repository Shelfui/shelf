{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/storybook-static/**",
    "**/.tmp/**",
    "bun.lock",
    "**/*.md",
    "apps/*/.shelf/**",
    "apps/web/.next/**",
    "apps/*/src/components/ui/**",
    "apps/*/src/components/blocks/**",
    "examples/**/.shelf/**",
    "examples/**/src/components/ui/**",
    "apps/web/src/demos/**/*.json"
  ]
}
