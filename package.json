{
  "name": "shelf",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "bun run --cwd packages/cli build",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run deps && bun run doctor && bun run verify --check && bun run audit && bun run test && bun run test:perf && bun run test:storybook",
    "typecheck": "bun check --no-script",
    "lint": "oxlint --type-aware --deny-warnings --disable-nested-config",
    "lint:fix": "oxlint --type-aware --disable-nested-config --fix",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "test": "bun test ./packages ./registry ./apps/web/scripts",
    "test:storybook": "vitest run --project storybook",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "figma:build": "bun build packages/figma/src/plugin/main.ts --outfile packages/cli/dist/figma/code.js --format iife --target browser && cp packages/figma/manifest.json packages/cli/dist/figma/manifest.json",
    "registry:build": "bun run verify && bun packages/cli/src/index.ts build registry --out dist/registry --verify dist/verify.json",
    "registry:serve": "bun packages/cli/src/index.ts serve registry",
    "skill:write": "bun packages/cli/src/skill-write.ts",
    "site:build": "bun run --cwd apps/registry build --outDir ../../packages/cli/dist/site --emptyOutDir",
    "changeset": "changeset",
    "release:version": "changeset version && bun install",
    "doctor": "react-doctor registry --no-telemetry --no-supply-chain --blocking warning",
    "test:perf": "vitest run --project perf",
    "verify": "bun scripts/verify/index.ts",
    "smoke": "bun scripts/smoke.ts",
    "audit": "bun scripts/verify/audit.ts",
    "deps": "bun scripts/deps.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.24",
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-bubble-menu": "^3.32.1",
    "@tiptap/extension-document": "^3.32.1",
    "@tiptap/extension-drag-handle": "^3.32.1",
    "@tiptap/extension-drag-handle-react": "^3.32.1",
    "@tiptap/extension-floating-menu": "^3.32.1",
    "@tiptap/extension-hard-break": "^3.32.1",
    "@tiptap/extension-heading": "^3.32.1",
    "@tiptap/extension-highlight": "^3.32.1",
    "@tiptap/extension-mention": "^3.32.1",
    "@tiptap/extension-paragraph": "^3.32.1",
    "@tiptap/extension-placeholder": "^3.32.1",
    "@tiptap/extension-task-item": "^3.32.1",
    "@tiptap/extension-task-list": "^3.32.1",
    "@tiptap/extension-text": "^3.32.1",
    "@tiptap/extensions": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@tiptap/suggestion": "^3.32.1",
    "culori": "4.0.2",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "1.65.0",
    "marked": "^18.1.2",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-dropzone": "^20.1.4",
    "react-resizable-panels": "^4.15.2",
    "recharts": "3.10.1",
    "remend": "^1.4.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.10",
    "@babel/plugin-syntax-jsx": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@changesets/cli": "3.0.3",
    "@figma/plugin-typings": "1.142.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@stylexjs/eslint-plugin": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@types/babel__core": "7.20.5",
    "@types/bun": "1.4.4",
    "@types/culori": "4.0.1",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.1",
    "react-doctor": "0.9.18",
    "storybook": "10.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "axe-core": "4.13.0"
  }
}
